{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Migrate": false
  },
  "Jwt": {
    "Issuer": "Canchero",
    "Audience": "Canchero",
    "ExpirationMinutes": 60
  },
  "Geocoding": {
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "Canchero/1.0",
    "CountryCodes": "co",
    "CacheMinutes": 60,
    "TimeoutSeconds": 10
  },
  "Reservations": {
    "PendingExpirationMinutes": 30,
    "SweepIntervalSeconds": 60
  },
  "RateLimiting": {
    "SearchPermitsPerMinute": 30
  },
  "Swagger": {
    "Enabled": false
  }
}
